diff --git a/src/pages/DashboardAdmin.jsx b/src/pages/DashboardAdmin.jsx
index c62840c..1dd4864 100644
--- a/src/pages/DashboardAdmin.jsx
+++ b/src/pages/DashboardAdmin.jsx
@@ -170,6 +170,13 @@ export default function DashboardAdmin({ pengguna, onLogout }) {
     cocokKataKunci(`${item.nama} ${item.email} ${item.jabatan || ""} ${item.divisi || ""}`, cariKaryawan)
   );
 
+  // Angka ringkasan buat kartu statistik, dihitung dari data yang sudah dimuat
+  // (tidak perlu request tambahan ke server)
+  const jumlahKaryawanAktif = karyawan.filter((k) => k.statusAkun === "aktif").length;
+  const jumlahHadirHariIni = rekap.length;
+  const jumlahTelatHariIni = rekap.filter((r) => (r.statusFinal || r.statusOtomatis) === "telat").length;
+  const jumlahAlphaHariIni = Math.max(jumlahKaryawanAktif - jumlahHadirHariIni, 0);
+
   const tabs = [
     { id: "rekap", label: "Rekap Hari Ini" },
     { id: "approval", label: `Menunggu${menunggu.length > 0 ? ` (${menunggu.length})` : ""}` },
@@ -192,6 +199,27 @@ export default function DashboardAdmin({ pengguna, onLogout }) {
         <button onClick={onLogout} style={styles.tombolLogout}>Keluar</button>
       </div>
 
+      {!loading && (
+        <div style={styles.statGrid}>
+          <div style={styles.statCard}>
+            <p style={styles.statAngka}>{jumlahKaryawanAktif}</p>
+            <p style={styles.statLabel}>Karyawan Aktif</p>
+          </div>
+          <div style={styles.statCard}>
+            <p style={{ ...styles.statAngka, color: warna.sukses }}>{jumlahHadirHariIni}</p>
+            <p style={styles.statLabel}>Hadir Hari Ini</p>
+          </div>
+          <div style={styles.statCard}>
+            <p style={{ ...styles.statAngka, color: warna.peringatan }}>{jumlahTelatHariIni}</p>
+            <p style={styles.statLabel}>Telat</p>
+          </div>
+          <div style={styles.statCard}>
+            <p style={{ ...styles.statAngka, color: warna.bahaya }}>{jumlahAlphaHariIni}</p>
+            <p style={styles.statLabel}>Belum Absen</p>
+          </div>
+        </div>
+      )}
+
       <div style={styles.tabGroup}>
         {tabs.map((t) => (
           <button
@@ -389,7 +417,15 @@ export default function DashboardAdmin({ pengguna, onLogout }) {
 }
 
 const styles = {
-  wrapper: { minHeight: "100vh", background: warna.latar, fontFamily: font.display, padding: 16 },
+  wrapper: {
+    minHeight: "100vh",
+    background: warna.latar,
+    backgroundImage:
+      "linear-gradient(#E4E8E4 1px, transparent 1px), linear-gradient(90deg, #E4E8E4 1px, transparent 1px)",
+    backgroundSize: "28px 28px",
+    fontFamily: font.display,
+    padding: 16,
+  },
   header: {
     display: "flex",
     justifyContent: "space-between",
@@ -413,6 +449,22 @@ const styles = {
     color: warna.tintaLembut,
   },
   tabGroup: { display: "flex", gap: 6, maxWidth: 600, margin: "0 auto 16px auto", flexWrap: "wrap" },
+  statGrid: {
+    display: "grid",
+    gridTemplateColumns: "repeat(4, 1fr)",
+    gap: 8,
+    maxWidth: 600,
+    margin: "0 auto 16px auto",
+  },
+  statCard: {
+    background: warna.panel,
+    border: `1px solid ${warna.garis}`,
+    borderRadius: 3,
+    padding: "14px 8px",
+    textAlign: "center",
+  },
+  statAngka: { fontSize: 22, fontWeight: 700, color: warna.tinta, margin: 0, fontFamily: font.mono },
+  statLabel: { fontSize: 10.5, color: warna.tintaLembut, margin: "4px 0 0 0", lineHeight: 1.3 },
   tab: {
     flex: 1,
     padding: "10px 6px",
