---
 src/index.css                   |   9 ++++
 src/pages.zip                   | Bin 23817 -> 0 bytes
 src/pages/DashboardAdmin.jsx    |  88 ++++++++++++++++++++++++++++++--
 src/pages/DashboardKaryawan.jsx |   7 ++-
 4 files changed, 100 insertions(+), 4 deletions(-)
 delete mode 100644 src/pages.zip

diff --git a/src/index.css b/src/index.css
index 3841284..3081ff5 100644
--- a/src/index.css
+++ b/src/index.css
@@ -102,3 +102,12 @@ code {
   padding: 4px 8px;
   background: var(--code-bg);
 }
+
+/* Animasi untuk skeleton loading (dipakai lewat class .skeleton-pulse) */
+@keyframes denyut-skeleton {
+  0%, 100% { opacity: 0.55; }
+  50% { opacity: 1; }
+}
+.skeleton-pulse {
+  animation: denyut-skeleton 1.3s ease-in-out infinite;
+}
diff --git a/src/pages.zip b/src/pages.zip
deleted file mode 100644
