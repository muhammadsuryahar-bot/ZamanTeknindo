# Salin file ini jadi ".env" (untuk lokal) lalu sesuaikan isinya.
# Untuk production, isi variabel yang sama ini di dashboard Vercel:
# Project Settings > Environment Variables.

# ============================================================
# DATABASE (Supabase Postgres)
# ============================================================
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Opsional: jumlah koneksi Prisma per instance serverless.
# Default runtime = 2, dibatasi 1..5. Naikkan hanya setelah monitoring
# production menunjukkan pool masih kekurangan kapasitas.
PRISMA_CONNECTION_LIMIT="2"

# ============================================================
# SUPABASE STORAGE (untuk upload foto absen)
# ============================================================
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="ganti_dengan_service_role_key_RAHASIA"

  SUPABASE_BUCKET_FOTO=foto-absensi
  FACE_THRESHOLD=0.5
  JAM_MASUK_MAX=08:10
  JAM_PULANG_MIN=17:00
  JAM_MASUK_STANDAR=08:10
  JAM_PULANG_STANDAR=17:00
  FACE_CACHE_TTL=300000
  ENFORCE_LIVENESS=true

# ============================================================
# BACKEND
# ============================================================
PORT=5000
JWT_SECRET="ganti_dengan_teks_rahasia_bebas_123!@#"
ALLOWED_EMAIL_DOMAIN="contohperusahaan.com"
ADMIN_EMAIL="admin@gmail.com"

# Origin frontend yang boleh akses API. Pisahkan beberapa origin dengan koma.
FRONTEND_URL="https://zaman-teknindo.vercel.app,https://facescan-zaman-teknindo.vercel.app"

# ============================================================
# FRONTEND (opsional)
# ============================================================
# Kosongkan pada project utama yang melayani frontend dan API di domain yang sama.
# Pada project Facescan terpisah, arahkan semua request ke API project utama.
# VITE_API_URL="https://zaman-teknindo.vercel.app/api"
