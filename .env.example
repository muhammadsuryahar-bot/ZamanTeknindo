# Salin file ini jadi ".env" (untuk lokal) lalu sesuaikan isinya.
# Untuk production, isi variabel yang sama ini di dashboard Vercel:
# Project Settings > Environment Variables.

# ============================================================
# DATABASE (Supabase Postgres)
# ============================================================
# Ambil dari: Supabase Project Settings > Database > Connection String
# WAJIB pakai versi "Transaction pooler" (port 6543) karena Vercel
# serverless bikin banyak koneksi baru tiap request.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ============================================================
# SUPABASE STORAGE (untuk upload foto absen)
# ============================================================
# Ambil dari: Supabase Project Settings > API
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="ganti_dengan_service_role_key_RAHASIA"

# ============================================================
# BACKEND
# ============================================================
PORT=5000

# Kunci rahasia untuk membuat token login (JWT). Ganti dengan teks acak panjang.
JWT_SECRET="ganti_dengan_teks_rahasia_bebas_123!@#"

# Domain email yang diizinkan mendaftar (validasi email kantor)
ALLOWED_EMAIL_DOMAIN="contohperusahaan.com"

# Domain frontend tambahan yang boleh akses API (di luar aturan otomatis
# untuk localhost/ngrok/*.vercel.app yang sudah ditangani di kode).
# Isi dengan domain custom production kamu, contoh:
# FRONTEND_URL="https://absensi.ptzamanteknindo.com"
FRONTEND_URL=""

# ============================================================
# FRONTEND (opsional)
# ============================================================
# KOSONGKAN / JANGAN DI-SET saat frontend & backend digabung 1 domain
# Vercel -- kode sudah otomatis pakai "/api" secara relatif.
# VITE_API_URL="/api"
